{
  "info": {
    "name": "GraphQL Microservices API",
    "description": "Complete GraphQL Microservices Platform with Pure JWT Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "description": "Authentication and User Management",
      "item": [
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"RegisterUser\",\n  \"query\": \"mutation RegisterUser($username: String!, $email: String!, $password: String!) { register(username: $username, email: $email, password: $password) { success message } }\",\n  \"variables\": {\n    \"username\": \"testuser\",\n    \"email\": \"test@test.com\",\n    \"password\": \"Test@123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "2. Login User",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"Login\",\n  \"query\": \"mutation Login($username: String!, $password: String!, $platform: String!, $deviceName: String!) { login(username: $username, password: $password, platform: $platform, deviceName: $deviceName) { success accessToken refreshToken user { id username email } } }\",\n  \"variables\": {\n    \"username\": \"testuser\",\n    \"password\": \"Test@123\",\n    \"platform\": \"web\",\n    \"deviceName\": \"Postman\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "3. Get Current User (ME)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetMe\",\n  \"query\": \"query GetMe { me { id username email emailVerified dateJoined } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "4. Refresh Token",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"RefreshToken\",\n  \"query\": \"mutation RefreshToken($refreshToken: String!, $platform: String!) { refreshToken(refreshToken: $refreshToken, platform: $platform) { success accessToken refreshToken } }\",\n  \"variables\": {\n    \"refreshToken\": \"{{refreshToken}}\",\n    \"platform\": \"web\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"Logout\",\n  \"query\": \"mutation Logout($refreshToken: String!) { logout(refreshToken: $refreshToken) { success message } }\",\n  \"variables\": {\n    \"refreshToken\": \"{{refreshToken}}\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "6. Change Password",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"ChangePassword\",\n  \"query\": \"mutation ChangePassword($oldPassword: String!, $newPassword: String!) { changePassword(oldPassword: $oldPassword, newPassword: $newPassword) { success message } }\",\n  \"variables\": {\n    \"oldPassword\": \"Test@123\",\n    \"newPassword\": \"NewPass@123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "7. Get My Devices",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetMyDevices\",\n  \"query\": \"query GetMyDevices { myDevices { id deviceName deviceId lastLogin ipAddress } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "8. Remove Device",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"RemoveDevice\",\n  \"query\": \"mutation RemoveDevice($deviceId: String!) { removeDevice(deviceId: $deviceId) { success message } }\",\n  \"variables\": {\n    \"deviceId\": \"DEVICE_ID_HERE\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "9. Remove Other Devices",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"RemoveOtherDevices\",\n  \"query\": \"mutation RemoveOtherDevices { removeOtherDevices { success message count } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "10. Get My Sessions",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetMySessions\",\n  \"query\": \"query GetMySessions { mySessions { deviceId platform createdAt lastAccessed expiresAt } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "11. Verify Email",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"VerifyEmail\",\n  \"query\": \"mutation VerifyEmail($uidb64: String!, $token: String!) { verifyEmail(uidb64: $uidb64, token: $token) { success message } }\",\n  \"variables\": {\n    \"uidb64\": \"YOUR_UID\",\n    \"token\": \"YOUR_TOKEN\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "12. Request Password Reset",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"PasswordResetRequest\",\n  \"query\": \"mutation PasswordResetRequest($email: String!) { passwordResetRequest(email: $email) { success message } }\",\n  \"variables\": {\n    \"email\": \"test@test.com\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "13. Set New Password",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"SetNewPassword\",\n  \"query\": \"mutation SetNewPassword($uidb64: String!, $token: String!, $newPassword: String!) { setNewPassword(uidb64: $uidb64, token: $token, newPassword: $newPassword) { success message } }\",\n  \"variables\": {\n    \"uidb64\": \"YOUR_UID\",\n    \"token\": \"YOUR_TOKEN\",\n    \"newPassword\": \"NewPass@123\"\n  }\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blog Service",
      "description": "Blog Post Management",
      "item": [
        {
          "name": "1. Create Upload (Without Image)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"CreateUpload\",\n  \"query\": \"mutation CreateUpload($title: String!, $description: String!) { createUpload(title: $title, description: $description) { success message upload { id title description createdAt } } }\",\n  \"variables\": {\n    \"title\": \"My First Blog\",\n    \"description\": \"Hello World\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "2. Create Upload (With Image)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "operations",
                  "value": "{\"operationName\":\"CreateUpload\",\"query\":\"mutation CreateUpload($title: String!, $description: String!, $file: Upload!) { createUpload(title: $title, description: $description, uploadedImages: [$file]) { success message upload { id title images } } }\",\"variables\":{\"title\":\"Blog with Image\",\"description\":\"This post has an image\",\"file\":null}}",
                  "type": "text"
                },
                {
                  "key": "map",
                  "value": "{\"0\":[\"variables.file\"]}",
                  "type": "text"
                },
                {
                  "key": "0",
                  "type": "file",
                  "src": "/path/to/your/image.jpg"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get All Uploads",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetAllUploads\",\n  \"query\": \"query GetAllUploads { allUploads { id title description images createdAt } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "4. Get Single Upload",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetUpload\",\n  \"query\": \"query GetUpload($id: String!) { upload(id: $id) { id title description images createdAt } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "5. Get My Uploads",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetMyUploads\",\n  \"query\": \"query GetMyUploads { myUploads { id title description images createdAt } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "6. Update Upload",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"UpdateUpload\",\n  \"query\": \"mutation UpdateUpload($id: String!, $title: String!, $description: String!) { updateUpload(id: $id, title: $title, description: $description) { success message upload { id title description } } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\",\n    \"title\": \"Updated Title\",\n    \"description\": \"Updated Description\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "7. Delete Upload",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/graphql/blog/",
            "auth": {
              "type": "bearer",
              "bearer": ["{{accessToken}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"DeleteUpload\",\n  \"query\": \"mutation DeleteUpload($id: String!) { deleteUpload(id: $id) { success message } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\"\n  }\n}"
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ]
}