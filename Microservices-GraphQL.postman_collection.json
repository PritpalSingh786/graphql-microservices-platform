{
  "info": {
    "name": "GraphQL Microservices API",
    "description": "Complete GraphQL Microservices Platform with Pure JWT Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "description": "Authentication and User Management",
      "item": [
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"register\",\n  \"query\": \"mutation register($userId: String!, $email: String!, $password: String!) { register(userId: $userId, email: $email, password: $password) { success message userId email } }\",\n  \"variables\": {\n    \"userId\": \"testuser\",\n    \"email\": \"test@test.com\",\n    \"password\": \"Test@123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "2. Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"login\",\n  \"query\": \"mutation login($userId: String!, $password: String!, $platform: String!) { login(userId: $userId, password: $password, platform: $platform) { success message access refresh user { id userId email emailVerified } } }\",\n  \"variables\": {\n    \"userId\": \"testuser\",\n    \"password\": \"Test@123\",\n    \"platform\": \"web\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "3. Get Current User (ME)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"me\",\n  \"query\": \"query me { me { success message user { id userId email emailVerified dateJoined } deviceId platform } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "4. Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"refreshToken\",\n  \"query\": \"mutation refreshToken($refresh: String!, $platform: String!) { refreshToken(refresh: $refresh, platform: $platform) { success access refresh } }\",\n  \"variables\": {\n    \"refresh\": \"{{refreshToken}}\",\n    \"platform\": \"web\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"logout\",\n  \"query\": \"mutation logout($refresh: String!) { logout(refresh: $refresh) { success message } }\",\n  \"variables\": {\n    \"refresh\": \"{{refreshToken}}\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "6. Forgot Password (Request Reset)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"forgotPassword\",\n  \"query\": \"mutation forgotPassword($userId: String!) { forgotPassword(userId: $userId) { success message } }\",\n  \"variables\": {\n    \"userId\": \"testuser\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "7. Change Password (with Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"changePassword\",\n  \"query\": \"mutation changePassword($userId: String!, $token: String!, $newPassword: String!, $confirmPassword: String!) { changePassword(userId: $userId, token: $token, newPassword: $newPassword, confirmPassword: $confirmPassword) { success message } }\",\n  \"variables\": {\n    \"userId\": \"1\",\n    \"token\": \"RESET_TOKEN_HERE\",\n    \"newPassword\": \"NewPass@123\",\n    \"confirmPassword\": \"NewPass@123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "8. Secure Change Password (with Current Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"secureChangePassword\",\n  \"query\": \"mutation secureChangePassword($userId: String!, $token: String!, $currentPassword: String!, $newPassword: String!, $confirmPassword: String!) { secureChangePassword(userId: $userId, token: $token, currentPassword: $currentPassword, newPassword: $newPassword, confirmPassword: $confirmPassword) { success message redirect } }\",\n  \"variables\": {\n    \"userId\": \"1\",\n    \"token\": \"SECURE_TOKEN_HERE\",\n    \"currentPassword\": \"Test@123\",\n    \"newPassword\": \"NewPass@123\",\n    \"confirmPassword\": \"NewPass@123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "9. Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"verifyEmail\",\n  \"query\": \"mutation verifyEmail($userId: String!, $token: String!) { verifyEmail(userId: $userId, token: $token) { success message userId email } }\",\n  \"variables\": {\n    \"userId\": \"testuser\",\n    \"token\": \"VERIFICATION_TOKEN_HERE\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "12. Get My Devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"myDevices\",\n  \"query\": \"query myDevices { myDevices { id deviceName deviceId lastLogin ipAddress isActive } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "13. Get User by ID (Query)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/auth/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"getUser\",\n  \"query\": \"query getUser($userId: String!) { getUser(userId: $userId) { id userId email emailVerified } }\",\n  \"variables\": {\n    \"userId\": \"testuser\"\n  }\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blog Service",
      "description": "Blog Post Management",
      "item": [
        {
          "name": "1. Create Upload (Without Image)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"CreateUpload\",\n  \"query\": \"mutation CreateUpload($title: String!, $description: String!) { createUpload(title: $title, description: $description) { success message upload { id title description createdAt } } }\",\n  \"variables\": {\n    \"title\": \"My First Blog\",\n    \"description\": \"Hello World\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "2. Create Upload (With Image)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "operations",
                  "value": "{\"operationName\":\"CreateUpload\",\"query\":\"mutation CreateUpload($title: String!, $description: String!, $file: Upload!) { createUpload(title: $title, description: $description, uploadedImages: [$file]) { success message upload { id title images } } }\",\"variables\":{\"title\":\"Blog with Image\",\"description\":\"This post has an image\",\"file\":null}}",
                  "type": "text"
                },
                {
                  "key": "map",
                  "value": "{\"0\":[\"variables.file\"]}",
                  "type": "text"
                },
                {
                  "key": "0",
                  "type": "file",
                  "src": "/path/to/your/image.jpg"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get All Uploads",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetAllUploads\",\n  \"query\": \"query GetAllUploads { allUploads { id title description images createdAt } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "4. Get Single Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetUpload\",\n  \"query\": \"query GetUpload($id: String!) { upload(id: $id) { id title description images createdAt } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "5. Get My Uploads",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"GetMyUploads\",\n  \"query\": \"query GetMyUploads { myUploads { id title description images createdAt } }\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "6. Update Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"UpdateUpload\",\n  \"query\": \"mutation UpdateUpload($id: String!, $title: String!, $description: String!) { updateUpload(id: $id, title: $title, description: $description) { success message upload { id title description } } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\",\n    \"title\": \"Updated Title\",\n    \"description\": \"Updated Description\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "7. Delete Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "http://localhost:8000/graphql/blog/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationName\": \"DeleteUpload\",\n  \"query\": \"mutation DeleteUpload($id: String!) { deleteUpload(id: $id) { success message } }\",\n  \"variables\": {\n    \"id\": \"UPLOAD_ID_HERE\"\n  }\n}"
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "id": "accessToken",
      "name": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "id": "refreshToken",
      "name": "refreshToken",
      "value": "",
      "type": "string"
    }
  ]
}